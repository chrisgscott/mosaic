# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection (for pgmq)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Processing Configuration
POLL_INTERVAL=5
BATCH_SIZE=1
MAX_RETRIES=3

# Document Processor Selection
# Set to "true" to use Docling (VLM-based, faster), "false" for Unstructured (OCR-based, legacy)
USE_DOCLING=false

# Docling VLM Configuration (only used if USE_DOCLING=true)
# Set to "true" for API-based VLM (GPT-4o-mini, faster, requires OPENAI_API_KEY)
# Set to "false" for local VLM (GraniteDocling, slower but free and private)
USE_API_VLM=true

# OpenAI API Key (required if USE_DOCLING=true and USE_API_VLM=true)
OPENAI_API_KEY=your-openai-key
