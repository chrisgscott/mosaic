# =============================================================================
# Mosaic Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# -----------------------------------------------------------------------------
SUPABASE_DB_PASSWORD=your-database-password
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_KEY=your-jwt-secret

# -----------------------------------------------------------------------------
# OpenAI API Key (Required)
# Get key at: https://platform.openai.com/api-keys
# Used for: embeddings, chat completions, document processing
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key

# -----------------------------------------------------------------------------
# Cohere API Key (Required for reranking)
# Get free key at: https://dashboard.cohere.com/api-keys
# Free tier: 100 requests/month for rerank
# Production tier: $1 per 1000 searches
# -----------------------------------------------------------------------------
COHERE_API_KEY=your-cohere-api-key

# -----------------------------------------------------------------------------
# AI Gateway Configuration (Optional - for model routing)
# Sign up at: https://vercel.com/ai-gateway
# Provides unified model access with automatic failover
# -----------------------------------------------------------------------------
AI_GATEWAY_API_KEY=your-ai-gateway-key

# -----------------------------------------------------------------------------
# Tavily API Key (Optional - for web search in chat)
# Get key at: https://tavily.com/
# Used for: web search tool in chat
# -----------------------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key

# -----------------------------------------------------------------------------
# Legacy API Key (Optional - for backward compatibility)
# Used by external tools (n8n, etc.) before database API keys were added
# New integrations should use database-managed API keys instead
# -----------------------------------------------------------------------------
MOSAIC_API_KEY=your-legacy-api-key
N8N_SEARCH_API_KEY=your-n8n-api-key
