# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection (for pgmq)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Processing Configuration
POLL_INTERVAL=5
BATCH_SIZE=1
MAX_RETRIES=3
LOG_LEVEL=INFO  # Set to DEBUG for verbose logging

# Document Processor Selection
# Set to "true" to use Docling (VLM-based, faster), "false" for Unstructured (OCR-based, legacy)
USE_DOCLING=false

# Docling VLM Configuration (only used if USE_DOCLING=true)
# Set to "true" for API-based VLM (GPT-4o-mini, faster, requires OPENAI_API_KEY)
# Set to "false" for local VLM (GraniteDocling, slower but free and private)
USE_API_VLM=true

# Docling Parallel Processing (only used if USE_DOCLING=true)
# Number of pages to process simultaneously (default: 10)
# Higher = faster but more memory. 10 workers = ~1GB RAM for 216-page PDF
DOCLING_MAX_WORKERS=10

# OpenAI API Key (required if USE_DOCLING=true and USE_API_VLM=true, or if ENABLE_GRAPH_EXTRACTION=true)
OPENAI_API_KEY=your-openai-key

# Graph RAG Configuration
# Set to "true" to extract entities and relationships during document processing
# This builds a knowledge graph for advanced relationship-based queries
ENABLE_GRAPH_EXTRACTION=true

# Entity deduplication similarity threshold (0.0-1.0)
# Higher = stricter matching (fewer duplicates but might miss similar entities)
# Lower = looser matching (more duplicates but catches more variations)
# Default: 0.85 (recommended)
ENTITY_SIMILARITY_THRESHOLD=0.85
