# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_KEY=your-jwt-key

# OpenAI API Key (for embeddings)
OPENAI_API_KEY=sk-your-openai-key

# Cohere API Key (for reranking with rerank-english-v3.0)
# Get free key at: https://dashboard.cohere.com/api-keys
# Free tier: 100 requests/month for rerank
# Production tier: $1 per 1000 searches
COHERE_API_KEY=your_cohere_api_key

# AI Gateway Configuration (for RAG answer generation)
# Sign up at: https://vercel.com/ai-gateway
# Provides unified model access with automatic failover
AI_GATEWAY_API_KEY=your_ai_gateway_key

# Anthropic API Key (for Claude models via AI Gateway)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key
