# =============================================================================
# Mosaic Backend (Ingest Worker) Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Database Connection (Required)
# Get connection string from: Supabase Dashboard > Settings > Database > Connection string
# Use the "Transaction pooler" connection string for pgmq
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# Processing Configuration
# -----------------------------------------------------------------------------
POLL_INTERVAL=5          # Seconds between queue polls
BATCH_SIZE=1             # Documents to process per batch
MAX_RETRIES=3            # Max retry attempts for failed documents
LOG_LEVEL=INFO           # Set to DEBUG for verbose logging

# -----------------------------------------------------------------------------
# Docling Configuration
# Docling is used for document parsing (PDF, DOCX, etc.)
# -----------------------------------------------------------------------------
USE_DOCLING=true         # Enable Docling for document processing
USE_API_VLM=true         # true = GPT-4o-mini (faster), false = local model (free)
DOCLING_MAX_WORKERS=15   # Parallel page processing (higher = faster, more RAM)

# -----------------------------------------------------------------------------
# OpenAI API Key (Required)
# Get key at: https://platform.openai.com/api-keys
# Used for: VLM processing (if USE_API_VLM=true), embeddings, graph extraction
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key

# -----------------------------------------------------------------------------
# Google API Key (Optional - for Gemini models)
# Get key at: https://aistudio.google.com/app/apikey
# Used for: Alternative LLM provider, planner-executor chunking
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key

# -----------------------------------------------------------------------------
# Graph RAG Configuration
# Extracts entities and relationships during document processing
# -----------------------------------------------------------------------------
ENABLE_GRAPH_EXTRACTION=true      # Enable knowledge graph building
ENTITY_SIMILARITY_THRESHOLD=0.85  # Deduplication threshold (0.0-1.0)
